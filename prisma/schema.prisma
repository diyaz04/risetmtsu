generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase pooler (port 6543, ?pgbouncer=true)
  directUrl = env("DIRECT_URL")   // Supabase direct (port 5432) untuk migrasi
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum ResearchField {
  AGAMA
  HUMANIORA
  SAINS
}

enum TitleStatus {
  PENDING
  APPROVED
  REVISION
  REJECTED
}

enum ChapterStatus {
  LOCKED
  DRAFT
  SUBMITTED
  REVISION
  APPROVED
}

model User {
  id                 String   @id @default(cuid())
  name               String
  username           String   @unique // siswa: namalengkap@riset.com
  passwordHash       String
  role               Role
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())

  student  StudentProfile?
  teacher  TeacherProfile?
  comments Comment[]
}

model TeacherProfile {
  id     String        @id @default(cuid())
  userId String        @unique
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  field  ResearchField

  students StudentProfile[]
}

model StudentProfile {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  nis       String?        @unique
  kelas     String?
  // diisi saat guru mengklaim; null = masih di pool umum
  teacherId String?
  teacher   TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  field     ResearchField?
  claimedAt DateTime?

  research Research?

  @@index([teacherId])
  @@index([field])
}

model Research {
  id        String         @id @default(cuid())
  studentId String         @unique
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String? // judul yang sudah di-ACC
  createdAt DateTime       @default(now())

  titles   TitleSubmission[]
  chapters Chapter[]
}

model TitleSubmission {
  id          String      @id @default(cuid())
  researchId  String
  research    Research    @relation(fields: [researchId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TitleStatus @default(PENDING)
  teacherNote String?
  createdAt   DateTime    @default(now())
  reviewedAt  DateTime?

  @@index([researchId])
}

model Chapter {
  id          String        @id @default(cuid())
  researchId  String
  research    Research      @relation(fields: [researchId], references: [id], onDelete: Cascade)
  number      Int
  content     Json? // dokumen editor (Tiptap JSON)
  status      ChapterStatus @default(LOCKED)
  updatedAt   DateTime      @updatedAt
  submittedAt DateTime?

  versions ChapterVersion[]
  comments Comment[]

  @@unique([researchId, number])
}

model ChapterVersion {
  id        String   @id @default(cuid())
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  content   Json
  createdAt DateTime @default(now())

  @@index([chapterId])
}

model Comment {
  id        String   @id @default(cuid())
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([chapterId])
}
