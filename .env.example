# Supabase > Connect > ORM > Prisma
# Transaction pooler (port 6543) untuk aplikasi
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD_URL_ENCODED@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (port 5432) untuk prisma db push / migrate
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD_URL_ENCODED@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Rahasia sesi login: openssl rand -base64 32
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Akun admin utama (dipakai oleh `npm run db:seed`)
ADMIN_USERNAME="admin@riset.com"
ADMIN_PASSWORD="ganti-password-ini"
